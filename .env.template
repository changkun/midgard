# Sign-in through auth.latere.ai (specs/redesign.md §4). Copy to .env, which
# docker-compose.yml reads and git ignores.
AUTH_URL=https://auth.latere.ai
# Who may use this server: comma-separated emails or principal ids. Empty
# means no one signs in through auth.latere.ai. A principal id admits its
# devices at once; an email, once its person has signed in on the web page.
AUTH_ALLOWED_PRINCIPALS=

# Sign-in from a browser, for the web page at /midgard/. Leave AUTH_CLIENT_ID
# empty to go without it; the API and mg work the same.
AUTH_CLIENT_ID=
# Encrypts the session cookie: openssl rand -hex 32. Keep it secret; a new
# one signs everyone out.
AUTH_COOKIE_KEY=
# Where auth.latere.ai sends a browser back to. The default is the configured
# domain's /midgard/.auth/callback.
# AUTH_REDIRECT_URL=
# For trying it on http://localhost only: cookies without Secure.
# AUTH_INSECURE_COOKIES=1
